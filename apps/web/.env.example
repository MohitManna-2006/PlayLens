# Where the web app reads plays, frames, and metadata.
#   api (default) — the PlayLens FastAPI service at NEXT_PUBLIC_PLAYLENS_API_BASE_URL,
#                   serving real NFL tracking data. If it is down the UI shows an error;
#                   it never falls back to fixtures.
#   fixture       — procedurally generated synthetic plays and in-browser baseline/mock
#                   models for interface development. Labeled "Synthetic fixture data".
NEXT_PUBLIC_PLAYLENS_DATA_SOURCE=api
NEXT_PUBLIC_PLAYLENS_API_BASE_URL=http://localhost:8000
