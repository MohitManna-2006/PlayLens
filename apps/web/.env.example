# Where the web app reads plays, frames, and model outputs.
#   fixture — procedurally generated synthetic plays and in-browser baseline/mock models
#             for interface development. The UI labels this mode everywhere.
#   api     — the PlayLens FastAPI service at NEXT_PUBLIC_API_URL (/api/v1 contract).
NEXT_PUBLIC_PLAYLENS_DATA_SOURCE=fixture
NEXT_PUBLIC_API_URL=http://localhost:8000
