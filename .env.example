# Application Environment
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://playlens_dev:playlens_dev@localhost:5432/playlens
POSTGRES_USER=playlens_dev
POSTGRES_PASSWORD=playlens_dev
POSTGRES_DB=playlens

# Redis
REDIS_URL=redis://localhost:6379/0

# PlayLens API (Phase 2 serves processed Parquet; Postgres and Redis are not required yet)
# Data directory; defaults to <repo>/data when unset.
# PLAYLENS_DATA_ROOT=/absolute/path/to/data
# Processed subset the API serves: dev or full.
PLAYLENS_SUBSET=dev
PLAYLENS_LOG_LEVEL=INFO

# Web app (copy into apps/web/.env.local; see apps/web/.env.example)
NEXT_PUBLIC_PLAYLENS_DATA_SOURCE=api
NEXT_PUBLIC_PLAYLENS_API_BASE_URL=http://localhost:8000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# AI Provider (Placeholders)
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
